index 0000000..592980e
--- /dev/null
+++ b/kernel/model/custom_cloud_user_test.go
@@ -0,0 +1,115 @@
+package model
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+func setupCustomCloudUserTest(t *testing.T) {
+	t.Helper()
+	setupCloudAccountAuthTest(t)
+	Conf.Sync.Load().Provider = conf.ProviderS3
+	Conf.Sync.Load().Enabled = false
+	Conf.SetUser(nil)
+	Conf.UserData = ""
+	Conf.Save()
+}
+
+func TestCustomCloudUserPersistsAcrossReload(t *testing.T) {
+	setupCustomCloudUserTest(t)
+	user := GetCustomCloudUser()
+	if user == nil || user.UserSiYuanProExpireTime != -1 || user.UserSiYuanOneTimePayStatus != 1 {
+		t.Fatal("local account did not grant the existing custom-build features")
+	}
+	data, err := os.ReadFile(filepath.Join(util.ConfDir, "conf.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(data, []byte(`"userToken"`)) {
+		t.Fatal("account fields were persisted without encryption")
+	}
+	restored := NewAppConf()
+	if err = json.Unmarshal(data, restored); err != nil {
+		t.Fatal(err)
+	}
+	Conf = restored
+	reloaded := loadUserFromConf()
+	if !reflect.DeepEqual(user, reloaded) {
+		t.Fatal("persisted local account could not be restored")
+	}
+	Conf.SetUser(reloaded)
+	if GetCustomCloudUser() != reloaded || Conf.Sync.Load().Provider != conf.ProviderS3 ||
+		Conf.Sync.Load().Enabled || string(Conf.Repo.Load().Key) != "0123456789abcdef0123456789abcdef" {
+		t.Fatal("restoring the account changed sync settings or the repository encryption key")
+	}
+}
+
+func TestCustomCloudUserCachedDuringSync(t *testing.T) {
+	setupCustomCloudUserTest(t)
+	user := GetCustomCloudUser()
+	persisted := Conf.UserData
+	release := lockAssetSourceChange()
+	defer release()
+	done := make(chan *conf.User, 1)
+	go func() { done <- GetCustomCloudUser() }()
+	select {
+	case got := <-done:
+		if got != user || Conf.UserData != persisted {
+			t.Fatal("cached read replaced or rewrote the local account")
+		}
+	case <-time.After(3 * time.Second):
+		release()
+		<-done
+		t.Fatal("cached local account query waited for synchronization")
+	}
+}
+
+func TestCustomCloudUserRefreshKeepsLocalAccount(t *testing.T) {
+	setupCustomCloudUserTest(t)
+	user := GetCustomCloudUser()
+	persisted := Conf.UserData
+	previousReminded := subscriptionExpirationReminded
+	t.Cleanup(func() { subscriptionExpirationReminded = previousReminded })
+	called := false
+	mockCloudAuthResponse(t, func(request *http.Request) (*http.Response, error) {
+		called = true
+		return cloudAuthResponse(request, http.StatusUnauthorized, ""), nil
+	})
+	for _, token := range []string{"", user.UserToken} {
+		got, err := RefreshUser(token)
+		if err != nil || got != user {
+			t.Fatal("refresh revoked the local account")
+		}
+	}
+	refreshUser()
+	if called || Conf.GetUser() != user || Conf.UserData != persisted {
+		t.Fatal("background refresh contacted the official cloud or changed the local account")
+	}
+}
+
+func TestCustomCloudAccountSurvivesAuthFailure(t *testing.T) {
+	setupCustomCloudUserTest(t)
+	user := GetCustomCloudUser()
+	persisted := Conf.UserData
+	called := false
+	mockCloudAuthResponse(t, func(request *http.Request) (*http.Response, error) {
+		called = true
+		return cloudAuthResponse(request, http.StatusUnauthorized, `{"code":-1,"msg":"rejected"}`), nil
+	})
+	if _, err := GetCloudShorthands(1); err == nil || !called {
+		t.Fatal("official cloud request did not return its authentication failure")
+	}
+	if Conf.GetUser() != user || Conf.UserData != persisted || Conf.Sync.Load().Provider != conf.ProviderS3 ||
+		Conf.GetUser().UserSiYuanOneTimePayStatus != 1 {
+		t.Fatal("official cloud authentication failure revoked local features or changed third-party sync")
+	}
+}
