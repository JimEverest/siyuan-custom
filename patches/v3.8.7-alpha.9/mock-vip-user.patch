+func isCustomCloudUser(user *conf.User) bool {
+	return user != nil && user.UserId == "0" && user.UserName == "_" && user.UserToken == "token" &&
+		user.UserSiYuanProExpireTime == -1 && user.UserSiYuanOneTimePayStatus == 1
+}
+
+// GetCustomCloudUser preserves the local account-free entitlement of this custom build.
+// Reuse an existing local account without blocking cached reads during synchronization.
+func GetCustomCloudUser() *conf.User {
+	if user := Conf.GetUser(); isCustomCloudUser(user) {
+		return user
+	}
+	release := lockAssetSourceChange()
+	defer release()
+	cloudAccountMu.Lock()
+	defer cloudAccountMu.Unlock()
+
+	user := &conf.User{
+		UserId:                       "0",
+		UserName:                     "_",
+		UserAvatarURL:                "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7",
+		UserTitles:                   []*conf.UserTitle{},
+		UserCreateTime:               "29991231 00:00:00",
+		UserSiYuanProExpireTime:      -1,
+		UserToken:                    "token",
+		UserTokenExpireTime:          "32503593600",
+		UserSiYuanSubscriptionPlan:   0,
+		UserSiYuanSubscriptionStatus: 0,
+		UserSiYuanSubscriptionType:   1,
+		UserSiYuanOneTimePayStatus:   1,
+	}
+	Conf.SetUser(user)
+	data, _ := gulu.JSON.MarshalJSON(user)
+	Conf.UserData = util.AESEncrypt(string(data))
+	Conf.Save()
+	return user
+}
